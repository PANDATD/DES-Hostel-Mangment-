APP_ENV=development
APP_TIMEZONE=Asia/Kolkata

SECRET_KEY=replace-with-a-long-random-secret

PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_SHOW_LINK=1

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=10
MAIL_SUPPRESS_SEND=0

# Neon pooled connection for application runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional Neon direct connection for migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

HOSTEL_LAT=
HOSTEL_LNG=
HOSTEL_RADIUS_METRES=150
MAX_GPS_ACCURACY_METRES=100
