APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
APP_TIMEZONE=Asia/Kolkata

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_SHOW_LINK=1

# SMTP
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=10
MAIL_SUPPRESS_SEND=0

# Database
DATABASE_URL=

# Geography attendance
HOSTEL_LAT=
HOSTEL_LNG=
HOSTEL_RADIUS_METRES=150
MAX_GPS_ACCURACY_METRES=100
