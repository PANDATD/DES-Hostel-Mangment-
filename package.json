{
  "private": true,
  "scripts": {
    "build:css": "@tailwindcss/cli -i ./app/static/tailwind.css -o ./app/static/app.css --minify",
    "build:icons": "mkdir -p ./app/static/vendor/fontawesome/css ./app/static/vendor/fontawesome/webfonts && cp node_modules/@fortawesome/fontawesome-free/css/fontawesome.css node_modules/@fortawesome/fontawesome-free/css/solid.css node_modules/@fortawesome/fontawesome-free/css/brands.css ./app/static/vendor/fontawesome/css/ && cp -R node_modules/@fortawesome/fontawesome-free/webfonts/. ./app/static/vendor/fontawesome/webfonts/",
    "build": "npm run build:icons && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "@fortawesome/fontawesome-free": "7.3.1"
  }
}